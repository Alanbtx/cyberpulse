# ===== Backend (configure no painel do Render > Environment) =====
# Conexão com o Postgres (o Render preenche automaticamente se o banco estiver ligado)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberpulse

# Domínios que podem chamar a API pelo navegador (separados por vírgula)
CORS_ORIGINS=https://cyberpulse-ochre.vercel.app,http://localhost:5173
# Opcional: liberar previews da Vercel
# CORS_ORIGIN_REGEX=^https://cyberpulse-[a-z0-9-]+-alanbtx\.vercel\.app$

# Token longo e aleatório para /api/v1/admin/* (usado pelo cron do GitHub Actions).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Opcional, gratuito: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# IA
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=
# Reserva no OpenRouter: SOMENTE modelos gratuitos (a chave é do usuário, informada no site)
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
GEMINI_USE_SEARCH=true
GEMINI_TIMEOUT_SECONDS=90
AI_CACHE_DAYS=14

# Limites por IP, por minuto
RATE_LIMIT_AI_PER_MIN=5
RATE_LIMIT_SEARCH_PER_MIN=10

ENABLE_DOCS=false
ENABLE_SCHEDULER=true

# Docker local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
